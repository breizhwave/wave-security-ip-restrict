{
    "name": "breizhwave/wave-security-ip-restrict",
    "description": "Restrict a whole Laravel application to an IP allow list (IPv4, IPv6, CIDR), managed from .env and an optional admin page. PHP 5.6+ and Laravel 5.1 to 13.",
    "keywords": ["laravel", "ip", "whitelist", "allowlist", "cidr", "ipv6", "middleware", "security", "restrict"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "erwanpia"
        }
    ],
    "require": {
        "php": ">=5.6",
        "illuminate/support": "^5.1|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^5.1|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^5.1|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/console": "^5.1|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/view": "^5.1|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Wave\\SecurityIpRestrict\\": "src/"
        }
    },
    "scripts": {
        "test": "php tests/run.php"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Wave\\SecurityIpRestrict\\IpRestrictServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
